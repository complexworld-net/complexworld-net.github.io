<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code><![CDATA[globals [
   x  x0old rold deltatold hist
]

to go
  if (r != rold or x0 != x0old or deltat != deltatold) [
    set rold r
    set x0old x0
    set deltatold deltat
    replot
  ]

end

to startup
  set rold -1
  set x0old -1
  set deltatold -1
  clear-all-plots
end

to replot
  set-current-plot "map"
  clear-plot
  set-current-plot-pen "black"
  let xx 0
  while [xx < 1.005] [
    plotxy xx f(xx)
    set xx xx + 0.01
  ]
  set-current-plot-pen "red"
  plotxy 0 0
  plotxy 1 1
  set-current-plot-pen "green"
  set xx x0
  let yy 0
  plotxy xx 0
  repeat deltat [
    set yy f(xx)
    plotxy xx yy
    plotxy yy yy
    set xx yy
  ]
  set-current-plot "time-series"
  clear-plot
  set-plot-x-range 0 deltat
  set xx x0
  let t 0
  let i 0
  set hist n-values 100 [0]
  plotxy t xx
  repeat deltat [
    set xx f(xx)
    plotxy t xx
    set i int(xx * 100)
    set hist replace-item i hist (item i hist + 1)
    set t t + 1
  ]
  set-current-plot "histogram"
  clear-plot
  set-plot-y-range 0 max hist
  set-plot-pen-interval (1 / 100)
  set-plot-pen-mode 1
  set i 0
  repeat 100 [
    plot item i hist
    set i i + 1
  ]

end

to-report f [xx]
  report r * xx * (1 - xx)
end]]></code>
